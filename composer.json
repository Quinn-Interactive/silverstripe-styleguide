{
    "name": "quinninteractive/silverstripe-styleguide",
    "description": "Generates a styleguide for a SilverStripe theme",
    "type": "silverstripe-vendormodule",
    "homepage": "https://github.com/Quinn-Interactive/silverstripe-styleguide",
    "keywords": [
        "silverstripe",
        "styleguide",
        "kss"
    ],
    "support": {
        "issues": "https://github.com/Quinn-Interactive/silverstripe-styleguide/issues"
    },
    "authors": [
        {
            "name": "benmanu",
            "email": "bmanu10@gmail.com",
            "role": "Creator"
        },
        {
            "name": "Quinn Interactive, Inc.",
            "email": "support+styleguide@quinn.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "silverstripe/framework": "^4",
        "symfony/finder": ">=2.8 <5.0",
        "erusev/parsedown": "^1.6.0"
    },
    "require-dev": {
        "phpunit/PHPUnit": "~3.7@stable"
    },
    "extra": {
        "installer-name": "styleguide",
        "expose": [
            "dist",
            "images"
        ]
    }
}
